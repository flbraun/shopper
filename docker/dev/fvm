#!/usr/bin/env bash
# fvm stand-in for the dev container: Flutter is preinstalled at the
# version from .fvmrc, so "fvm flutter …" and "fvm dart …" run directly.
case "${1:-}" in
  flutter | dart) exec "$@" ;;
  *)
    echo "fvm (container shim): only 'fvm flutter …' and 'fvm dart …' are supported." >&2
    echo "Flutter $(flutter --version --machine 2>/dev/null | jq -r .frameworkVersion) is preinstalled." >&2
    exit 1
    ;;
esac
